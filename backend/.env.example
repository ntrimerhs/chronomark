# Copy this file to backend/.env and fill in the keys you actually have.
# backend/.env is gitignored -- never commit real keys.

# --- LLM / answering (llama.py) -------------------------------------------
# Preferred: DeepSeek (cheap, OpenAI-compatible, also does vision).
# Leave blank to fall back to OpenAI, then to the HF Inference API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Fallback LLM.
OPENAI_API_KEY=

# Last-resort LLM (Llama-3.1-8B-Instruct) and used as the ASR token when no
# OpenAI/Groq key is present.
HF_TOKEN=

# --- Transcription (whisper.py) -------------------------------------------
# Groq Whisper is the cheapest/fastest hosted option (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# Used only when OPENAI_API_KEY is set; Groq is preferred when both exist.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Dedicated HF Inference Endpoint instead of the shared serverless route.
HF_WHISPER_ENDPOINT_URL=
HF_WHISPER_ENDPOINT_TOKEN=

# Pin the transcript language to skip detection (e.g. el, en).
WHISPER_LANGUAGE=

# Local faster-whisper fallback. Off by default: on CPU it is ~0.7x realtime.
# Requires `pip install faster-whisper` first.
WHISPER_LOCAL=0
WHISPER_LOCAL_MODEL=small
