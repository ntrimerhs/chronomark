# Copy this file to backend/.env and fill in the keys you actually have.
# backend/.env is gitignored -- never commit real keys.

# --- LLM / answering (llama.py) -------------------------------------------
# Preferred: DeepSeek (cheap, OpenAI-compatible, also does vision).
# Leave blank to fall back to OpenAI, then to the HF Inference API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Fallback LLM.
OPENAI_API_KEY=

# Last-resort LLM (Llama-3.1-8B-Instruct) and used as the ASR token when no
# OpenAI/Groq key is present.
HF_TOKEN=

# --- Transcription (whisper.py) -------------------------------------------
# Groq Whisper is the cheapest/fastest hosted option (OpenAI-compatible API).
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# Used only when OPENAI_API_KEY is set; Groq is preferred when both exist.
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Dedicated HF Inference Endpoint instead of the shared serverless route.
HF_WHISPER_ENDPOINT_URL=
HF_WHISPER_ENDPOINT_TOKEN=

# Pin the transcript language to skip detection (e.g. el, en).
WHISPER_LANGUAGE=

# Local faster-whisper fallback. Off by default: on CPU it is ~0.7x realtime.
# Requires `pip install faster-whisper` first.
WHISPER_LOCAL=0
WHISPER_LOCAL_MODEL=small

# --- Vector store (qdrant_store.py) ----------------------------------------
# Point at a Qdrant Cloud cluster (or any Qdrant server) to share the index
# across machines. Leave QDRANT_URL empty to use the embedded local store
# (./qdrant_data, single process only).
QDRANT_URL=
QDRANT_API_KEY=

# --- Object storage: Cloudflare R2 (services/r2_service.py) -----------------
# Videos upload straight from the browser to R2 via presigned URLs. Create an
# account-scoped R2 API token with Object Read & Write, and set the bucket's
# CORS policy to allow PUT from the frontend origin.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- YouTube downloads (main.py /download-youtube/) --------------------------
# yt-dlp runs inside the backend container (Deno + yt-dlp-ejs baked in) with
# the account session from cookies.txt, which is mounted at /app/cookies.txt
# and re-read on every invocation -- regenerating it needs no restart.
# YouTube bot-checks datacenter IPs ("Sign in to confirm you're not a bot");
# when fresh cookies are not enough, route ONLY yt-dlp through a
# residential/mobile proxy:
YT_DLP_PROXY=
