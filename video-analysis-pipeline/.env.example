# Verified against https://api-docs.deepseek.com/guides/vision/ (2026-02)
# deepseek-flash accepts images; each image costs at most 1024 tokens.
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-chat

FRAME_INTERVAL_SEC=5
MAX_FRAMES_PER_SEGMENT=120
MAX_FRAMES_PER_REQUEST=8
IMAGE_MAX_SIDE=512
JPEG_QUALITY=3
MAX_PARALLEL_SEGMENTS=3
MAX_RETRIES=3
REQUEST_TIMEOUT_SEC=120
MAX_REQUESTS_PER_RUN=200

DATA_DIR=/data
KEEP_FRAMES=false
LOG_LEVEL=INFO